      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css');\n.miu{font-family:'Inter',sans-serif;}\n</style>\n<div class=\"miu relative w-[375px] h-[812px] overflow-hidden bg-[#F7F4EF] text-[#1C1B1F]\" data-kid=\"1\" data-name=\"phone app screen container\">\n<div class=\"flex items-center justify-between px-[26px] pt-[14px] h-[50px] text-[15px] font-semibold\" data-kid=\"1-1\" data-name=\"system status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar clock time\">9:41</span>\n<div class=\"flex items-center gap-[5px]\" data-kid=\"1-1-2\" data-name=\"connection status icons group\"><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"cellular signal wrapper\"><i class=\"ph-fill ph-cell-signal-full\" data-kid=\"1-1-2-1-1\" data-name=\"cellular signal full icon\"></i></span><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-2\" data-name=\"wifi signal wrapper\"><i class=\"ph-fill ph-wifi-high\" data-kid=\"1-1-2-2-1\" data-name=\"wifi signal icon\"></i></span><span class=\"text-[22px] leading-none\" data-kid=\"1-1-2-3\" data-name=\"battery level wrapper\"><i class=\"ph-fill ph-battery-full\" data-kid=\"1-1-2-3-1\" data-name=\"battery full icon\"></i></span></div>\n</div>\n<div class=\"flex items-center justify-between px-[20px] mt-[14px]\" data-kid=\"1-2\" data-name=\"app header bar\">\n<h1 class=\"text-[30px] font-bold tracking-[-1.2px] leading-none\" data-kid=\"1-2-1\" data-name=\"app logo wordmark false\">miu.</h1>\n<span class=\"text-[22px] leading-none\" data-kid=\"1-2-2\" data-name=\"edit/compose icon wrapper\"><i class=\"ph ph-note-pencil\" data-kid=\"1-2-2-1\" data-name=\"edit pencil icon\"></i></span>\n</div>\n<div class=\"mx-[16px] mt-[20px] h-[44px] flex items-center gap-[10px] px-[16px] bg-[#FDFCFA] border border-[#ECE7E0] rounded-full\" data-kid=\"1-3\" data-name=\"search bar container\">\n<span class=\"text-[17px] leading-none text-[#9A948C]\" data-kid=\"1-3-1\" data-name=\"search icon wrapper\"><i class=\"ph ph-magnifying-glass\" data-kid=\"1-3-1-1\" data-name=\"magnifying glass search icon\"></i></span>\n<span class=\"text-[13.5px] text-[#A39D95]\" data-kid=\"1-3-2\" data-name=\"search placeholder text\">Search</span>\n</div>\n<div class=\"mt-[14px] bg-[#FDFCFA] border-t border-[#EFEBE5]\" data-kid=\"1-4\" data-name=\"notifications feed container\">\n<div class=\"flex items-center gap-[14px] px-[18px] h-[88px] border-b border-[#F0ECE6]\" data-kid=\"1-4-1\" data-name=\"notification row with photo\">\n<img alt=\"Silhouetted couple at sunset, photo by Rahul Thakuri on Pexels\" class=\"w-[54px] h-[54px] rounded-full object-cover\" data-kid=\"1-4-1-1\" data-name=\"notification avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/16034675/pexels-photo-16034675.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<div class=\"flex-1 min-w-0\" data-kid=\"1-4-1-2\" data-name=\"notification text content wrapper\">\n<div class=\"flex justify-between items-baseline\" data-kid=\"1-4-1-2-1\" data-name=\"notification title and time row\"><span class=\"text-[15px] font-semibold\" data-kid=\"1-4-1-2-1-1\" data-name=\"notification title label false\">You &amp; Her</span><span class=\"text-[11.5px] text-[#9A948C]\" data-kid=\"1-4-1-2-1-2\" data-name=\"notification timestamp label\">9:41</span></div>\n<div class=\"flex justify-between items-center mt-[5px]\" data-kid=\"1-4-1-2-2\" data-name=\"notification message and status row\"><span class=\"text-[13px] text-[#8C867E] truncate\" data-kid=\"1-4-1-2-2-1\" data-name=\"notification message preview text\">Can't wait to see you</span><span class=\"w-[9px] h-[9px] rounded-full bg-[#3B82F6] shrink-0\" data-kid=\"1-4-1-2-2-2\" data-name=\"unread status indicator dot\"></span></div>\n</div>\n</div>\n<div class=\"flex items-center gap-[14px] px-[18px] h-[88px] border-b border-[#F0ECE6]\" data-kid=\"1-4-2\" data-name=\"notification row with photo\">\n<img alt=\"Sun setting over the sea, photo by Ivan Torres on Unsplash\" class=\"w-[54px] h-[54px] rounded-full object-cover\" data-kid=\"1-4-2-1\" data-name=\"notification avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1598020976584-b52bb2b05fc3?auto=format&amp;w=160&amp;q=80&amp;fit=crop\"/>\n<div class=\"flex-1 min-w-0\" data-kid=\"1-4-2-2\" data-name=\"notification text content wrapper\">\n<div class=\"flex justify-between items-baseline\" data-kid=\"1-4-2-2-1\" data-name=\"notification title and time row\"><span class=\"text-[15px] font-semibold\" data-kid=\"1-4-2-2-1-1\" data-name=\"notification title label\">Daily Question</span><span class=\"text-[11.5px] text-[#9A948C]\" data-kid=\"1-4-2-2-1-2\" data-name=\"notification timestamp label\">8:30</span></div>\n<p class=\"mt-[5px] text-[13px] text-[#8C867E] truncate\" data-kid=\"1-4-2-2-2\" data-name=\"notification message preview text\">What's something you've always wanted to tell me?</p>\n</div>\n</div>\n<div class=\"flex items-center gap-[14px] px-[18px] h-[88px] border-b border-[#F0ECE6]\" data-kid=\"1-4-3\" data-name=\"notification row with photo\">\n<img alt=\"Polaroid photos, photo by Polina Tankilevitch on Pexels\" class=\"w-[54px] h-[54px] rounded-full object-cover\" data-kid=\"1-4-3-1\" data-name=\"notification avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6429525/pexels-photo-6429525.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=160&amp;q=80\"/>\n<div class=\"flex-1 min-w-0\" data-kid=\"1-4-3-2\" data-name=\"notification text content wrapper\">\n<div class=\"flex justify-between items-baseline\" data-kid=\"1-4-3-2-1\" data-name=\"notification title and time row\"><span class=\"text-[15px] font-semibold\" data-kid=\"1-4-3-2-1-1\" data-name=\"notification title label\">Memories</span><span class=\"text-[11.5px] text-[#9A948C]\" data-kid=\"1-4-3-2-1-2\" data-name=\"notification timestamp label\">Yesterday</span></div>\n<p class=\"mt-[5px] text-[13px] text-[#8C867E] truncate\" data-kid=\"1-4-3-2-2\" data-name=\"notification message preview text\">New photo added</p>\n</div>\n</div>\n<div class=\"flex items-center gap-[14px] px-[18px] h-[88px] border-b border-[#F0ECE6]\" data-kid=\"1-4-4\" data-name=\"notification row with icon avatar\">\n<div class=\"w-[54px] h-[54px] rounded-full bg-[#F6D8C2] flex items-center justify-center text-[24px] text-[#B4623A] shrink-0\" data-kid=\"1-4-4-1\" data-name=\"letters notification icon avatar\"><i class=\"ph ph-envelope-simple\" data-kid=\"1-4-4-1-1\" data-name=\"envelope icon\"></i></div>\n<div class=\"flex-1 min-w-0\" data-kid=\"1-4-4-2\" data-name=\"notification text content wrapper\">\n<div class=\"flex justify-between items-baseline\" data-kid=\"1-4-4-2-1\" data-name=\"notification title and time row\"><span class=\"text-[15px] font-semibold\" data-kid=\"1-4-4-2-1-1\" data-name=\"notification title label\">Letters</span><span class=\"text-[11.5px] text-[#9A948C]\" data-kid=\"1-4-4-2-1-2\" data-name=\"notification timestamp label\">Yesterday</span></div>\n<p class=\"mt-[5px] text-[13px] text-[#8C867E] truncate\" data-kid=\"1-4-4-2-2\" data-name=\"notification message preview text\">Open when you miss me</p>\n</div>\n</div>\n<div class=\"flex items-center gap-[14px] px-[18px] h-[88px] border-b border-[#F0ECE6]\" data-kid=\"1-4-5\" data-name=\"notification row with icon avatar\">\n<div class=\"w-[54px] h-[54px] rounded-full bg-[#D8E2EB] flex items-center justify-center text-[24px] text-[#47657F] shrink-0\" data-kid=\"1-4-5-1\" data-name=\"calendar notification icon avatar\"><i class=\"ph ph-calendar-check\" data-kid=\"1-4-5-1-1\" data-name=\"calendar checkmark icon\"></i></div>\n<div class=\"flex-1 min-w-0\" data-kid=\"1-4-5-2\" data-name=\"notification text content wrapper\">\n<div class=\"flex justify-between items-baseline\" data-kid=\"1-4-5-2-1\" data-name=\"notification title and time row\"><span class=\"text-[15px] font-semibold\" data-kid=\"1-4-5-2-1-1\" data-name=\"notification title label\">Timeline</span><span class=\"text-[11.5px] text-[#9A948C]\" data-kid=\"1-4-5-2-1-2\" data-name=\"notification timestamp label\">Monday</span></div>\n<p class=\"mt-[5px] text-[13px] text-[#8C867E] truncate\" data-kid=\"1-4-5-2-2\" data-name=\"notification message preview text\">You added a new milestone</p>\n</div>\n</div>\n<div class=\"flex items-center gap-[14px] px-[18px] h-[88px]\" data-kid=\"1-4-6\" data-name=\"notification row with icon avatar\">\n<div class=\"w-[54px] h-[54px] rounded-full bg-[#E6E2DD] flex items-center justify-center text-[24px] text-[#55504A] shrink-0\" data-kid=\"1-4-6-1\" data-name=\"doodle notification icon avatar\"><i class=\"ph ph-scribble\" data-kid=\"1-4-6-1-1\" data-name=\"scrivble scribble icon\"></i></div>\n<div class=\"flex-1 min-w-0\" data-kid=\"1-4-6-2\" data-name=\"notification text content wrapper\">\n<div class=\"flex justify-between items-baseline\" data-kid=\"1-4-6-2-1\" data-name=\"notification title and time row\"><span class=\"text-[15px] font-semibold\" data-kid=\"1-4-6-2-1-1\" data-name=\"notification title label\">Doodle</span><span class=\"text-[11.5px] text-[#9A948C]\" data-kid=\"1-4-6-2-1-2\" data-name=\"notification timestamp label\">Sunday</span></div>\n<p class=\"mt-[5px] text-[13px] text-[#8C867E] truncate\" data-kid=\"1-4-6-2-2\" data-name=\"notification message preview text\">Shared a doodle</p>\n</div>\n</div>\n</div>\n<nav class=\"absolute bottom-0 left-0 right-0 h-[90px] bg-[#FBFAF7] border-t border-[#EDE8E1] flex justify-around pt-[12px]\" data-kid=\"1-5\" data-name=\"bottom tab navigation bar\">\n<div class=\"flex flex-col items-center gap-[4px] w-[70px] text-[#1C1B1F]\" data-kid=\"1-5-1\" data-name=\"chats navigation tab (active)\"><span class=\"text-[24px] leading-none\" data-kid=\"1-5-1-1\" data-name=\"chats tab icon wrapper\"><i class=\"ph-fill ph-chat-circle\" data-kid=\"1-5-1-1-1\" data-name=\"chat bubble icon\"></i></span><span class=\"text-[10.5px] font-semibold\" data-kid=\"1-5-1-2\" data-name=\"chats tab label\">Chats</span></div>\n<div class=\"flex flex-col items-center gap-[4px] w-[70px] text-[#8C867E]\" data-kid=\"1-5-2\" data-name=\"together navigation tab\"><span class=\"text-[24px] leading-none\" data-kid=\"1-5-2-1\" data-name=\"together tab icon wrapper\"><i class=\"ph ph-users-three\" data-kid=\"1-5-2-1-1\" data-name=\"three users icon\"></i></span><span class=\"text-[10.5px]\" data-kid=\"1-5-2-2\" data-name=\"together tab label\">Together</span></div>\n<div class=\"flex flex-col items-center gap-[4px] w-[70px] text-[#8C867E]\" data-kid=\"1-5-3\" data-name=\"memories navigation tab\"><span class=\"text-[24px] leading-none\" data-kid=\"1-5-3-1\" data-name=\"memories tab icon wrapper\"><i class=\"ph ph-images-square\" data-kid=\"1-5-3-1-1\" data-name=\"images gallery icon\"></i></span><span class=\"text-[10.5px]\" data-kid=\"1-5-3-2\" data-name=\"memories tab label\">Memories</span></div>\n<div class=\"flex flex-col items-center gap-[4px] w-[70px] text-[#8C867E]\" data-kid=\"1-5-4\" data-name=\"profile navigation tab\"><span class=\"text-[24px] leading-none\" data-kid=\"1-5-4-1\" data-name=\"profile tab icon wrapper\"><i class=\"ph ph-user\" data-kid=\"1-5-4-1-1\" data-name=\"single user icon\"></i></span><span class=\"text-[10.5px]\" data-kid=\"1-5-4-2\" data-name=\"profile tab label\">Profile</span></div>\n</nav>\n<div class=\"absolute bottom-[9px] left-1/2 -translate-x-1/2 w-[134px] h-[5px] rounded-full bg-[#1C1B1F]\" data-kid=\"1-6\" data-name=\"home indicator bar\"></div>\n</div>",
