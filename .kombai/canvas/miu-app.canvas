      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css');\n.miu{font-family:'Inter',sans-serif;}\n.chatbg{background-color:#EEE9E1;background-image:radial-gradient(rgba(150,135,115,0.12) 1px,transparent 1.2px);background-size:16px 16px;}\n.bin{background:#fff;border-radius:14px 14px 14px 4px;box-shadow:0 1px 1px rgba(60,40,20,0.06);}\n.bout{background:#DCF3CE;border-radius:14px 14px 4px 14px;box-shadow:0 1px 1px rgba(60,40,20,0.06);}\n</style>\n<div class=\"miu relative w-[375px] h-[812px] overflow-hidden bg-[#F7F4EF] text-[#1C1B1F]\" data-kid=\"1\" data-name=\"mobile chat app screen container\">\n<div class=\"flex items-center justify-between px-[26px] pt-[14px] h-[50px] text-[15px] font-semibold\" data-kid=\"1-1\" data-name=\"status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar time text\">9:41</span>\n<div class=\"flex items-center gap-[5px]\" data-kid=\"1-1-2\" data-name=\"signal wifi battery icons group\"><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\"><i class=\"ph-fill ph-cell-signal-full\" data-kid=\"1-1-2-1-1\"></i></span><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon\"><i class=\"ph-fill ph-wifi-high\" data-kid=\"1-1-2-2-1\"></i></span><span class=\"text-[22px] leading-none\" data-kid=\"1-1-2-3\" data-name=\"battery level icon\"><i class=\"ph-fill ph-battery-full\" data-kid=\"1-1-2-3-1\"></i></span></div>\n</div>\n<header class=\"h-[64px] flex items-center gap-[10px] px-[14px] border-b border-[#EAE5DE]\" data-kid=\"1-2\" data-name=\"chat header bar with contact info and actions\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-2-1\" data-name=\"back navigation caret icon\"><i class=\"ph ph-caret-left\" data-kid=\"1-2-1-1\"></i></span>\n<img alt=\"Silhouetted couple at sunset, photo by Rahul Thakuri on Pexels\" class=\"w-[42px] h-[42px] rounded-full object-cover\" data-kid=\"1-2-2\" data-name=\"contact profile avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/16034675/pexels-photo-16034675.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=120&amp;q=80\"/>\n<div class=\"flex-1\" data-kid=\"1-2-3\" data-name=\"contact name and status text block\">\n<p class=\"text-[15px] font-semibold leading-tight\" data-kid=\"1-2-3-1\" data-name=\"contact display name text\">You &amp; Her</p>\n<p class=\"text-[11.5px] text-[#8C867E]\" data-kid=\"1-2-3-2\" data-name=\"contact online status text\">online</p>\n</div>\n<div class=\"flex items-center gap-[18px] text-[22px] leading-none\" data-kid=\"1-2-4\" data-name=\"header action icons group\">\n<span data-kid=\"1-2-4-1\" data-name=\"video call action icon\"><i class=\"ph ph-video-camera\" data-kid=\"1-2-4-1-1\" data-name=\"video camera icon\"></i></span>\n<span data-kid=\"1-2-4-2\" data-name=\"voice call action icon\"><i class=\"ph ph-phone\" data-kid=\"1-2-4-2-1\" data-name=\"phone icon\"></i></span>\n<span class=\"text-[24px]\" data-kid=\"1-2-4-3\" data-name=\"more options action icon\"><i class=\"ph ph-dots-three-vertical\" data-kid=\"1-2-4-3-1\" data-name=\"vertical dots three menu icon\"></i></span>\n</div>\n</header>\n<div class=\"chatbg absolute top-[114px] bottom-[86px] left-0 right-0 px-[14px] pt-[16px] flex flex-col gap-[12px] text-[14px]\" data-kid=\"1-3\" data-name=\"chat messages scroll area with dotted background\">\n<div class=\"bin self-start px-[12px] py-[8px] flex items-end gap-[8px]\" data-kid=\"1-3-1\" data-name=\"incoming message bubble\"><span data-kid=\"1-3-1-1\" data-name=\"incoming message text\">Heyyy</span><span class=\"text-[10px] text-[#A39D95]\" data-kid=\"1-3-1-2\" data-name=\"incoming message timestamp\">9:35</span></div>\n<div class=\"bout self-end px-[12px] py-[8px] flex items-end gap-[8px]\" data-kid=\"1-3-2\" data-name=\"outgoing message bubble\"><span data-kid=\"1-3-2-1\" data-name=\"outgoing message text\">How are you? 😊</span><span class=\"text-[10px] text-[#7E9A70] flex items-center gap-[2px]\" data-kid=\"1-3-2-2\" data-name=\"outgoing message timestamp with read indicator\">9:36 <span class=\"text-[13px] leading-none text-[#3D9BE0]\" data-kid=\"1-3-2-2-1\" data-name=\"read indicator wrapper\"><i class=\"ph-bold ph-checks\" data-kid=\"1-3-2-2-1-1\" data-name=\"double checkmark read receipt icon\"></i></span></span></div>\n<div class=\"bin self-start px-[12px] py-[8px] max-w-[250px]\" data-kid=\"1-3-3\" data-name=\"incoming longer message bubble\"><p data-kid=\"1-3-3-1\" data-name=\"incoming message text\">I'm good! Just finished my work</p><p class=\"text-right text-[10px] text-[#A39D95] mt-[2px]\" data-kid=\"1-3-3-2\" data-name=\"incoming message timestamp\">9:37</p></div>\n<div class=\"bout self-end px-[12px] py-[8px] max-w-[250px]\" data-kid=\"1-3-4\" data-name=\"outgoing longer message bubble\"><p data-kid=\"1-3-4-1\" data-name=\"outgoing message text\">That's great! What are you up to now?</p><p class=\"text-right text-[10px] text-[#7E9A70] mt-[2px] flex justify-end items-center gap-[2px]\" data-kid=\"1-3-4-2\" data-name=\"outgoing message timestamp with read indicator\">9:38 <span class=\"text-[13px] leading-none text-[#3D9BE0]\" data-kid=\"1-3-4-2-1\" data-name=\"read indicator wrapper\"><i class=\"ph-bold ph-checks\" data-kid=\"1-3-4-2-1-1\" data-name=\"double checkmark read receipt icon\"></i></span></p></div>\n<div class=\"bin self-start px-[12px] py-[8px] flex items-end gap-[8px]\" data-kid=\"1-3-5\" data-name=\"incoming message bubble\"><span data-kid=\"1-3-5-1\" data-name=\"incoming message text\">Watching a show</span><span class=\"text-[10px] text-[#A39D95]\" data-kid=\"1-3-5-2\" data-name=\"incoming message timestamp\">9:40</span></div>\n<div class=\"bout self-end px-[12px] py-[8px] flex items-end gap-[8px]\" data-kid=\"1-3-6\" data-name=\"outgoing message bubble\"><span data-kid=\"1-3-6-1\" data-name=\"outgoing message text\">Send me a picture 😍</span><span class=\"text-[10px] text-[#7E9A70] flex items-center gap-[2px]\" data-kid=\"1-3-6-2\" data-name=\"outgoing message timestamp with read indicator\">9:41 <span class=\"text-[13px] leading-none text-[#3D9BE0]\" data-kid=\"1-3-6-2-1\" data-name=\"read indicator wrapper\"><i class=\"ph-bold ph-checks\" data-kid=\"1-3-6-2-1-1\" data-name=\"double checkmark read receipt icon\"></i></span></span></div>\n<div class=\"relative self-start bin p-[4px] mb-[10px]\" data-kid=\"1-3-7\" data-name=\"shared photo message bubble\">\n<img alt=\"Sunset over a calm ocean, photo by Ayşegül Aytören on Pexels\" class=\"w-[230px] h-[150px] rounded-[11px] object-cover\" data-kid=\"1-3-7-1\" data-name=\"shared ocean sunset photo image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11070084/pexels-photo-11070084.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=480&amp;q=80\"/>\n<span class=\"absolute right-[12px] bottom-[10px] text-[10px] text-white font-medium\" data-kid=\"1-3-7-2\" data-name=\"photo message timestamp badge\">9:41</span>\n<span class=\"absolute -bottom-[14px] left-[10px] w-[26px] h-[26px] rounded-full bg-white shadow-[0_1px_3px_rgba(0,0,0,0.12)] flex items-center justify-center text-[14px] text-[#E5383B] leading-none\" data-kid=\"1-3-7-3\" data-name=\"photo reaction heart button\"><i class=\"ph-fill ph-heart\" data-kid=\"1-3-7-3-1\" data-name=\"red filled heart like icon\"></i></span>\n</div>\n</div>\n<div class=\"absolute bottom-0 left-0 right-0 h-[86px] bg-[#F7F4EF] border-t border-[#EAE5DE] flex items-start gap-[10px] px-[14px] pt-[12px]\" data-kid=\"1-4\" data-name=\"chat message input bar\">\n<span class=\"text-[24px] leading-none mt-[8px]\" data-kid=\"1-4-1\" data-name=\"add attachment button\"><i class=\"ph ph-plus\" data-kid=\"1-4-1-1\" data-name=\"plus add icon\"></i></span>\n<div class=\"flex-1 h-[42px] bg-white rounded-full border border-[#ECE7E0] flex items-center px-[16px] gap-[12px]\" data-kid=\"1-4-2\" data-name=\"message input field with placeholder\">\n<span class=\"flex-1 text-[13.5px] text-[#A39D95]\" data-kid=\"1-4-2-1\" data-name=\"message input placeholder text\">Type a message...</span>\n<span class=\"text-[20px] leading-none text-[#6E6962]\" data-kid=\"1-4-2-2\" data-name=\"emoji picker button\"><i class=\"ph ph-smiley\" data-kid=\"1-4-2-2-1\" data-name=\"smiley face icon\"></i></span>\n<span class=\"text-[20px] leading-none text-[#6E6962]\" data-kid=\"1-4-2-3\" data-name=\"sticker picker button\"><i class=\"ph ph-sticker\" data-kid=\"1-4-2-3-1\" data-name=\"sticker icon\"></i></span>\n</div>\n<span class=\"text-[24px] leading-none mt-[8px]\" data-kid=\"1-4-3\" data-name=\"voice message record button\"><i class=\"ph ph-microphone\" data-kid=\"1-4-3-1\" data-name=\"microphone icon\"></i></span>\n</div>\n<div class=\"absolute bottom-[9px] left-1/2 -translate-x-1/2 w-[134px] h-[5px] rounded-full bg-[#1C1B1F]\" data-kid=\"1-5\" data-name=\"iphone home indicator bar\"></div>\n</div>",
