      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css');\n.miu{font-family:'Inter',sans-serif;}\n.miu input::placeholder{color:#A39D95;}\n</style>\n<div class=\"miu relative w-[375px] h-[812px] overflow-hidden text-[#1C1B1F]\" data-kid=\"1\" data-name=\"mobile screen layout container\" style=\"background:linear-gradient(180deg,#EDE3EE 0%,#F4EFF1 50%,#EEE5EE 100%)\">\n<div class=\"flex items-center justify-between px-[26px] pt-[14px] h-[50px] text-[15px] font-semibold\" data-kid=\"1-1\" data-name=\"status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar clock time\">9:41</span>\n<div class=\"flex items-center gap-[5px]\" data-kid=\"1-1-2\" data-name=\"status bar connectivity indicator group\"><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon container\"><i class=\"ph-fill ph-cell-signal-full\" data-kid=\"1-1-2-1-1\" data-name=\"cellular signal bars icon\"></i></span><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon container\"><i class=\"ph-fill ph-wifi-high\" data-kid=\"1-1-2-2-1\" data-name=\"wifi signal icon\"></i></span><span class=\"text-[22px] leading-none\" data-kid=\"1-1-2-3\" data-name=\"battery icon container\"><i class=\"ph-fill ph-battery-full\" data-kid=\"1-1-2-3-1\" data-name=\"battery full icon\"></i></span></div>\n</div>\n<div class=\"flex items-center px-[20px] h-[52px]\" data-kid=\"1-2\" data-name=\"header navigation bar\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-2-1\" data-name=\"back navigation button\"><i class=\"ph ph-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\"></i></span>\n</div>\n<div class=\"flex flex-col items-center mt-[18px]\" data-kid=\"1-3\" data-name=\"section header container\">\n<span class=\"text-[26px] leading-none\" data-kid=\"1-3-1\" data-name=\"calendar icon container\"><i class=\"ph ph-calendar-blank\" data-kid=\"1-3-1-1\" data-name=\"calendar icon\"></i></span>\n<h1 class=\"mt-[16px] text-[19px] font-medium\" data-kid=\"1-3-2\" data-name=\"screen title heading\">Daily Question</h1>\n</div>\n<div class=\"mx-[18px] mt-[30px] rounded-[22px] bg-[#FDFCFB] px-[22px] pt-[40px] pb-[24px] shadow-[0_2px_10px_rgba(110,80,110,0.05)]\" data-kid=\"1-4\" data-name=\"daily question card\">\n<p class=\"text-center text-[16px] font-medium leading-[1.55]\" data-kid=\"1-4-1\" data-name=\"question prompt text\">What's something<br data-kid=\"1-4-1-1\" data-name=\"line break\"/>you've always wanted<br data-kid=\"1-4-1-2\" data-name=\"line break\"/>to tell me?</p>\n<input class=\"mt-[30px] w-full h-[64px] px-[16px] rounded-[14px] border border-[#E7E1E5] bg-white outline-none text-[13.5px]\" data-kid=\"1-4-2\" data-name=\"answer text input field\" placeholder=\"Type your answer...\"/>\n<button class=\"mt-[20px] w-full h-[50px] rounded-[14px] bg-[#1E1F24] text-white text-[14px] font-semibold\" data-kid=\"1-4-3\" data-name=\"submit answer button\">Submit</button>\n</div>\n<div class=\"flex items-center justify-between px-[22px] mt-[30px]\" data-kid=\"1-5\" data-name=\"previous questions header row\">\n<p class=\"text-[13.5px] font-medium\" data-kid=\"1-5-1\" data-name=\"previous questions section label\">Previous questions</p>\n<p class=\"text-[12px] text-[#9A948C]\" data-kid=\"1-5-2\" data-name=\"see all link text\">See all</p>\n</div>\n<div class=\"mx-[18px] mt-[14px] rounded-[18px] bg-[#FDFCFB] px-[20px] py-[18px] flex items-center\" data-kid=\"1-6\" data-name=\"previous question card\">\n<div class=\"flex-1\" data-kid=\"1-6-1\" data-name=\"previous question content container\">\n<p class=\"text-[13.5px] leading-[1.5]\" data-kid=\"1-6-1-1\" data-name=\"previous question text\">What's your favourite<br data-kid=\"1-6-1-1-1\" data-name=\"line break\"/><span class=\"text-[#8C867E]\" data-kid=\"1-6-1-1-2\" data-name=\"question highlighted phrase\">memory of us?</span></p>\n<p class=\"mt-[10px] text-[11.5px] text-[#9A948C]\" data-kid=\"1-6-1-2\" data-name=\"question date text\">12 Mar 2025</p>\n</div>\n<span class=\"text-[16px] leading-none text-[#6E6962]\" data-kid=\"1-6-2\" data-name=\"card navigation caret icon\"><i class=\"ph ph-caret-right\" data-kid=\"1-6-2-1\" data-name=\"right caret chevron icon\"></i></span>\n</div>\n<div class=\"absolute bottom-[9px] left-1/2 -translate-x-1/2 w-[134px] h-[5px] rounded-full bg-[#1C1B1F]\" data-kid=\"1-7\" data-name=\"home indicator bar\"></div>\n</div>",
