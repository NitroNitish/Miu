      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/bold/style.css');\n.miu{font-family:'Inter',sans-serif;}\n</style>\n<div class=\"miu relative w-[375px] h-[812px] overflow-hidden bg-[#F7F4EF] text-[#1C1B1F]\" data-kid=\"1\" data-name=\"mobile profile page layout container\">\n<div class=\"flex items-center justify-between px-[26px] pt-[14px] h-[50px] text-[15px] font-semibold\" data-kid=\"1-1\" data-name=\"status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar clock text\">9:41</span>\n<div class=\"flex items-center gap-[5px]\" data-kid=\"1-1-2\" data-name=\"signal and battery status icons group\"><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon wrapper\"><i class=\"ph-fill ph-cell-signal-full\" data-kid=\"1-1-2-1-1\" data-name=\"cellular signal bars icon\"></i></span><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-2\" data-name=\"wifi icon wrapper\"><i class=\"ph-fill ph-wifi-high\" data-kid=\"1-1-2-2-1\" data-name=\"wifi icon\"></i></span><span class=\"text-[22px] leading-none\" data-kid=\"1-1-2-3\" data-name=\"battery icon wrapper\"><i class=\"ph-fill ph-battery-full\" data-kid=\"1-1-2-3-1\" data-name=\"battery icon\"></i></span></div>\n</div>\n<div class=\"flex items-center justify-between px-[20px] h-[52px]\" data-kid=\"1-2\" data-name=\"top app bar action bar\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-2-1\" data-name=\"back navigation button\"><i class=\"ph ph-arrow-left\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\"></i></span>\n<span class=\"text-[22px] leading-none\" data-kid=\"1-2-2\" data-name=\"overflow menu button\"><i class=\"ph-bold ph-dots-three-vertical\" data-kid=\"1-2-2-1\" data-name=\"three-dot vertical menu icon\"></i></span>\n</div>\n<div class=\"flex flex-col items-center pt-[14px] pb-[30px]\" data-kid=\"1-3\" data-name=\"profile hero section\">\n<img alt=\"Woman silhouetted against a sunset, photo by Rod Long on Unsplash\" class=\"w-[124px] h-[124px] rounded-full object-cover\" data-kid=\"1-3-1\" data-name=\"profile avatar photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1519873455438-c6778498f020?auto=format&amp;w=300&amp;q=80&amp;fit=crop\"/>\n<p class=\"mt-[22px] text-[20px] font-semibold tracking-[-0.3px]\" data-kid=\"1-3-2\" data-name=\"profile display name\">Her</p>\n<p class=\"mt-[4px] text-[13.5px] text-[#8C867E]\" data-kid=\"1-3-3\" data-name=\"online status text\">Online</p>\n</div>\n<div class=\"bg-[#FDFCFA] border-t border-[#EFEBE5] px-[22px]\" data-kid=\"1-4\" data-name=\"settings list container\">\n<div class=\"flex items-center gap-[16px] h-[66px] border-b border-[#F0ECE6]\" data-kid=\"1-4-1\" data-name=\"media settings row\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-4-1-1\" data-name=\"media icon wrapper\"><i class=\"ph ph-images-square\" data-kid=\"1-4-1-1-1\" data-name=\"images grid icon\"></i></span>\n<span class=\"flex-1 text-[14.5px]\" data-kid=\"1-4-1-2\" data-name=\"media settings row label\">Media, links and docs</span>\n<span class=\"text-[12px] text-[#9A948C]\" data-kid=\"1-4-1-3\" data-name=\"media item count badge\">248</span>\n<span class=\"text-[16px] leading-none text-[#8C867E]\" data-kid=\"1-4-1-4\" data-name=\"chevron disclosure wrapper\"><i class=\"ph ph-caret-right\" data-kid=\"1-4-1-4-1\" data-name=\"right chevron icon\"></i></span>\n</div>\n<div class=\"flex items-center gap-[16px] h-[66px] border-b border-[#F0ECE6]\" data-kid=\"1-4-2\" data-name=\"starred messages settings row\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-4-2-1\" data-name=\"star icon wrapper\"><i class=\"ph ph-star\" data-kid=\"1-4-2-1-1\" data-name=\"star icon\"></i></span>\n<span class=\"flex-1 text-[14.5px]\" data-kid=\"1-4-2-2\" data-name=\"starred messages row label\">Starred messages</span>\n<span class=\"text-[12px] text-[#9A948C]\" data-kid=\"1-4-2-3\" data-name=\"starred count badge\">12</span>\n<span class=\"text-[16px] leading-none text-[#8C867E]\" data-kid=\"1-4-2-4\" data-name=\"chevron disclosure wrapper\"><i class=\"ph ph-caret-right\" data-kid=\"1-4-2-4-1\" data-name=\"right chevron icon\"></i></span>\n</div>\n<div class=\"flex items-center gap-[16px] h-[66px] border-b border-[#F0ECE6]\" data-kid=\"1-4-3\" data-name=\"chat theme settings row\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-4-3-1\" data-name=\"paint palette icon wrapper\"><i class=\"ph ph-palette\" data-kid=\"1-4-3-1-1\" data-name=\"paint palette icon\"></i></span>\n<span class=\"flex-1 text-[14.5px]\" data-kid=\"1-4-3-2\" data-name=\"chat theme row label\">Chat theme</span>\n<span class=\"text-[16px] leading-none text-[#8C867E]\" data-kid=\"1-4-3-3\" data-name=\"chevron disclosure wrapper\"><i class=\"ph ph-caret-right\" data-kid=\"1-4-3-3-1\" data-name=\"right chevron icon\"></i></span>\n</div>\n<div class=\"flex items-center gap-[16px] h-[66px] border-b border-[#F0ECE6]\" data-kid=\"1-4-4\" data-name=\"notifications settings row\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-4-4-1\" data-name=\"bell icon wrapper\"><i class=\"ph ph-bell\" data-kid=\"1-4-4-1-1\" data-name=\"bell icon\"></i></span>\n<span class=\"flex-1 text-[14.5px]\" data-kid=\"1-4-4-2\" data-name=\"notifications row label\">Notifications</span>\n<span class=\"text-[16px] leading-none text-[#8C867E]\" data-kid=\"1-4-4-3\" data-name=\"chevron disclosure wrapper\"><i class=\"ph ph-caret-right\" data-kid=\"1-4-4-3-1\" data-name=\"right chevron icon\"></i></span>\n</div>\n<div class=\"flex items-center gap-[16px] h-[66px] border-b border-[#F0ECE6]\" data-kid=\"1-4-5\" data-name=\"disappearing messages settings row\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-4-5-1\" data-name=\"timer icon wrapper\"><i class=\"ph ph-timer\" data-kid=\"1-4-5-1-1\" data-name=\"timer clock icon\"></i></span>\n<span class=\"flex-1 text-[14.5px]\" data-kid=\"1-4-5-2\" data-name=\"disappearing messages row label\">Disappearing messages</span>\n<span class=\"text-[12px] text-[#9A948C]\" data-kid=\"1-4-5-3\" data-name=\"toggle state text value\">Off</span>\n<span class=\"text-[16px] leading-none text-[#8C867E]\" data-kid=\"1-4-5-4\" data-name=\"chevron disclosure wrapper\"><i class=\"ph ph-caret-right\" data-kid=\"1-4-5-4-1\" data-name=\"right chevron icon\"></i></span>\n</div>\n<div class=\"flex items-center gap-[16px] h-[66px]\" data-kid=\"1-4-6\" data-name=\"privacy settings row\">\n<span class=\"text-[22px] leading-none\" data-kid=\"1-4-6-1\" data-name=\"lock icon wrapper\"><i class=\"ph ph-lock-simple\" data-kid=\"1-4-6-1-1\" data-name=\"padlock icon\"></i></span>\n<span class=\"flex-1 text-[14.5px]\" data-kid=\"1-4-6-2\" data-name=\"privacy row label\">Privacy</span>\n<span class=\"text-[16px] leading-none text-[#8C867E]\" data-kid=\"1-4-6-3\" data-name=\"chevron disclosure wrapper\"><i class=\"ph ph-caret-right\" data-kid=\"1-4-6-3-1\" data-name=\"right chevron icon\"></i></span>\n</div>\n</div>\n<div class=\"absolute bottom-[9px] left-1/2 -translate-x-1/2 w-[134px] h-[5px] rounded-full bg-[#1C1B1F]\" data-kid=\"1-5\" data-name=\"home indicator bar\"></div>\n</div>",
