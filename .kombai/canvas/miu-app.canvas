      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css');\n.miu{font-family:'Inter',sans-serif;}\n</style>\n<div class=\"miu relative w-[375px] h-[812px] overflow-hidden bg-[#F7F4EF] text-[#1C1B1F]\" data-kid=\"1\" data-name=\"phone app screen layout container (miu)\">\n<div class=\"flex items-center justify-between px-[26px] pt-[14px] h-[50px] text-[15px] font-semibold\" data-kid=\"1-1\" data-name=\"status bar\">\n<span data-kid=\"1-1-1\" data-name=\"clock time text\">9:41</span>\n<div class=\"flex items-center gap-[5px]\" data-kid=\"1-1-2\" data-name=\"status icons group\"><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\"><i class=\"ph-fill ph-cell-signal-full\" data-kid=\"1-1-2-1-1\" data-name=\"cellular signal full icon\"></i></span><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-2\" data-name=\"wifi icon\"><i class=\"ph-fill ph-wifi-high\" data-kid=\"1-1-2-2-1\" data-name=\"wifi high icon\"></i></span><span class=\"text-[22px] leading-none\" data-kid=\"1-1-2-3\" data-name=\"battery icon\"><i class=\"ph-fill ph-battery-full\" data-kid=\"1-1-2-3-1\" data-name=\"battery full icon\"></i></span></div>\n</div>\n<h1 class=\"px-[22px] mt-[14px] text-[30px] font-bold tracking-[-1.2px] leading-none\" data-kid=\"1-2\" data-name=\"app logo headline\">miu.</h1>\n<div class=\"px-[18px] mt-[28px] flex flex-col gap-[12px]\" data-kid=\"1-3\" data-name=\"feature cards list container\">\n<div class=\"flex items-center gap-[16px] h-[100px] px-[16px] bg-[#FDFCFA] rounded-[18px] border border-[#EFEBE5]\" data-kid=\"1-3-1\" data-name=\"feature card container (Letters)\">\n<div class=\"w-[54px] h-[54px] rounded-full bg-[#F6DCCB] flex items-center justify-center text-[24px] text-[#5B3A2