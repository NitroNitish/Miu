      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/regular/style.css');\n@import url('https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/fill/style.css');\n.miu{font-family:'Inter',sans-serif;}\n.miu input::placeholder{color:#A39D95;}\n</style>\n<div class=\"miu relative w-[375px] h-[812px] overflow-hidden bg-[#F7F4EF] text-[#1C1B1F]\" data-kid=\"1\" data-name=\"login screen mobile container\">\n<div class=\"flex items-center justify-between px-[26px] pt-[14px] h-[50px] text-[15px] font-semibold\" data-kid=\"1-1\" data-name=\"phone status bar\">\n<span data-kid=\"1-1-1\" data-name=\"status bar clock time\">9:41</span>\n<div class=\"flex items-center gap-[5px]\" data-kid=\"1-1-2\" data-name=\"status bar signal and battery indicators\"><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-1\" data-name=\"cellular signal icon\"><i class=\"ph-fill ph-cell-signal-full\" data-kid=\"1-1-2-1-1\" data-name=\"cell signal full icon\"></i></span><span class=\"text-[16px] leading-none\" data-kid=\"1-1-2-2\" data-name=\"wifi signal icon wrapper\"><i class=\"ph-fill ph-wifi-high\" data-kid=\"1-1-2-2-1\" data-name=\"wifi high signal icon\"></i></span><span class=\"text-[22px] leading-none\" data-kid=\"1-1-2-3\" data-name=\"battery level icon wrapper\"><i class=\"ph-fill ph-battery-full\" data-kid=\"1-1-2-3-1\" data-name=\"battery full icon\"></i></span></div>\n</div>\n<div class=\"px-[32px]\" data-kid=\"1-2\" data-name=\"login form content section\">\n<h1 class=\"mt-[118px] text-[50px] font-bold tracking-[-2px] leading-none\" data-kid=\"1-2-1\" data-name=\"brand logo wordmark\">miu.</h1>\n<h2 class=\"mt-[46px] text-[22px] font-semibold tracking-[-0.4px]\" data-kid=\"1-2-2\" data-name=\"login greeting headline\">Welcome back</h2>\n<p class=\"mt-[6px] text-[14px] text-[#8C867E]\" data-kid=\"1-2-3\" data-name=\"login subtitle text\"